# Set this to your Hugging Face Space URL (or leave blank if proxying to local server)
VITE_API_BASE_URL=https://<your-username>-<your-space-name>.hf.space

# Optional: Hugging Face User Access Token (from https://huggingface.co/settings/tokens)
# Required if the space uses ZeroGPU and you exceed anonymous quota limits.
HF_TOKEN=hf_your_token_here

# --- Text detector (/predict-text) ---
# It runs in the browser; the ONNX model files are static files of this Hugging Face Space. No token needed.
VITE_TEXT_SPACE=M0HIT67/GhostRevaeal1.1
# Folder inside the Space under models/ (holds config.json, tokenizer.json, onnx/model.onnx)
VITE_TEXT_MODEL_DIR=text_onnx
# fp32 loads onnx/model.onnx, q8 loads onnx/model_quantized.onnx
VITE_TEXT_MODEL_DTYPE=fp32
VITE_TEXT_MAX_LENGTH=256
